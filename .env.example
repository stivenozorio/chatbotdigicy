# Copia este archivo a .env (local) o configura estas variables en el panel de GoDaddy.
# NUNCA subas el archivo .env al repositorio.

NODE_ENV=production
PORT=3000

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# MySQL (en GoDaddy se configuran automáticamente)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Google Gemini (en GoDaddy se configura en el panel; no la subas al repositorio)
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-3.5-flash)
GEMINI_MODEL=
# Opcional: nivel de razonamiento (minimal, low, medium, high) para reducir la latencia
GEMINI_THINKING_LEVEL=
# Opcional: límite global de solicitudes por minuto a /api/ai/test (por defecto 20)
AI_RATE_LIMIT_PER_MIN=
